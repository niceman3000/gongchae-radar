{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gongchae-radar.local/schemas/report-1.0.0.json",
  "title": "공채레이더 통합 리포트",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair_id",
    "pair_name",
    "institution",
    "checked_at",
    "prev",
    "curr",
    "tracks",
    "changes",
    "units",
    "competition",
    "requirements"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pair_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$"},
    "pair_name": {"type": "string", "minLength": 1},
    "institution": {"type": "string", "minLength": 1},
    "checked_at": {"type": "string", "format": "date"},
    "prev": {"$ref": "#/$defs/notice"},
    "curr": {"$ref": "#/$defs/notice"},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    },
    "change_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/change_group"}
    },
    "notice_info": {"$ref": "#/$defs/notice_info"},
    "units": {
      "type": "array",
      "items": {"$ref": "#/$defs/unit"}
    },
    "competition": {"$ref": "#/$defs/competition"},
    "requirements": {"$ref": "#/$defs/requirements"},
    "visual_summary": {"$ref": "#/$defs/visual_summary"},
    "tier": {
      "description": "verified: 원문 대조까지 끝낸 핵심 공고, auto: API 자동 수집·자동 비교만 한 공고",
      "enum": ["verified", "auto"]
    },
    "category": {"description": "공기업 유형 (시장형·준시장형)", "type": "string"}
  },
  "$defs": {
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sn", "title", "period", "pdf_path", "source_url"],
      "properties": {
        "sn": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "minLength": 1},
            "end": {"type": "string", "minLength": 1}
          }
        },
        "pdf_path": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "notice_sn", "page", "quote", "verified"],
      "properties": {
        "side": {"enum": ["prev", "curr"]},
        "notice_sn": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 300},
        "verified": {"type": "boolean"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "importance",
        "category",
        "title",
        "change_type",
        "prev_value",
        "curr_value",
        "source",
        "ai_label",
        "confidence",
        "status",
        "affected_units",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "importance": {"type": "integer", "minimum": 1, "maximum": 3},
        "category": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "change_type": {"enum": ["number", "added", "removed", "list", "text", "rename", "date"]},
        "prev_value": {"type": ["string", "number", "array", "null"]},
        "curr_value": {"type": ["string", "number", "array", "null"]},
        "source": {"enum": ["stage1", "stage2", "merged"]},
        "ai_label": {"enum": ["실질 변경", "표현 변경", null]},
        "confidence": {"enum": ["high", "low", "not_applicable"]},
        "status": {"enum": ["confirmed", "review_required", "not_published"]},
        "affected_units": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "change_group": {
      "description": "같은 변경이 여러 문장에 나뉘어 잡힌 후보 묶음. 변경점 id는 그대로 두고 화면에서만 카드 한 장으로 보인다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "member_ids", "shared_terms"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string"},
        "member_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "shared_terms": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "notice_info": {
      "description": "이번 공고에서 지원자가 챙길 것(접수기간·기준일·제출·우대사항). 작년과의 차이가 아니라 현재 공고 기준이다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "rules", "submissions", "benefits"],
      "properties": {
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"}
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "text"],
            "properties": {
              "topic": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "submissions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "name", "benefit", "notes", "change", "prev_benefit"],
            "properties": {
              "section": {"type": "string"},
              "name": {"type": "string", "minLength": 1},
              "benefit": {"type": ["string", "null"]},
              "notes": {"type": "array", "items": {"type": "string"}},
              "change": {"enum": ["new", "changed", "same"]},
              "prev_benefit": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "region_headcount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "prev", "curr", "evidence"],
      "properties": {
        "region": {"type": "string", "minLength": 1},
        "prev": {"type": ["integer", "null"], "minimum": 0},
        "curr": {"type": ["integer", "null"], "minimum": 0},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_name",
        "normalized_name",
        "track",
        "headcount_prev",
        "headcount_curr",
        "by_region",
        "evidence"
      ],
      "properties": {
        "unit_name": {"type": "string", "minLength": 1},
        "normalized_name": {"type": "string", "minLength": 1},
        "track": {"type": "string", "minLength": 1},
        "headcount_prev": {"type": ["integer", "null"], "minimum": 0},
        "headcount_curr": {"type": ["integer", "null"], "minimum": 0},
        "by_region": {"type": "array", "items": {"$ref": "#/$defs/region_headcount"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "requirement_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "applicable_units", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["required", "accepted", "bonus"]},
        "applicable_units": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "track": {"type": "string", "minLength": 1},
        "points": {"type": "number", "minimum": 0},
        "unit": {"description": "가점 단위: 점 또는 %(배점의 n%)", "enum": ["점", "%"]},
        "unrestricted": {"type": "boolean"},
        "match": {
          "description": "자격증 인정 목록. names(이름 그대로) 또는 items×grades(종목×등급)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "items": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "grades": {"type": "array", "items": {"enum": ["기능사", "산업기사", "기사", "기능장", "기술사"]}}
          }
        }
      }
    },
    "requirement_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracks", "regions", "certificates", "majors", "manual_review_conditions"],
      "properties": {
        "tracks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "regions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "certificates": {"type": "array", "items": {"$ref": "#/$defs/requirement_item"}},
        "majors": {"type": "array", "items": {"$ref": "#/$defs/requirement_item"}},
        "manual_review_conditions": {"type": "array", "items": {"type": "string"}},
        "units": {
          "description": "이번 공고 API의 모집단위와 직렬·구분. kind: general 일반, special 보훈·장애 등 대상자 전형, condition 별도 지원조건",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "track", "kind", "note", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "track": {"type": "string", "minLength": 1},
              "tracks": {"description": "이 모집단위로 찾을 수 있는 직렬 목록 (전기통신 → 전기·ICT). 11-21 추가", "type": "array", "items": {"type": "string", "minLength": 1}},
              "kind": {"enum": ["general", "special", "condition", "excluded"]},
              "note": {"type": ["string", "null"]},
              "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
            }
          }
        },
        "common_checks": {"type": "array", "items": {"$ref": "#/$defs/requirement_note"}},
        "region_note": {"anyOf": [{"$ref": "#/$defs/requirement_note"}, {"type": "null"}]},
        "bonus_rule": {"anyOf": [{"$ref": "#/$defs/requirement_note"}, {"type": "null"}]},
        "reviewed": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reviewed_at", "reviewer", "scope"],
              "properties": {
                "reviewed_at": {"type": "string"},
                "reviewer": {"type": "string"},
                "scope": {"type": "string"}
              }
            },
            {"type": "null"}
          ]
        }
      }
    },
    "numeric_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "prev", "curr", "unit"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "prev": {"type": "number", "minimum": 0},
        "curr": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "chart_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "prev", "curr"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "prev": {"type": "number", "minimum": 0},
        "curr": {"type": "number", "minimum": 0}
      }
    },
    "visual_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_headcount"],
      "properties": {
        "total_headcount": {"$ref": "#/$defs/numeric_pair"},
        "scope_note": {"type": "string", "minLength": 1},
        "headcount_breakdown": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/chart_row"}
        },
        "headcount_by_track": {
          "type": "array",
          "items": {"$ref": "#/$defs/chart_row"}
        },
        "selection_multiple": {"$ref": "#/$defs/numeric_pair"},
        "interview_weights": {
          "type": "array",
          "items": {"$ref": "#/$defs/chart_row"}
        }
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published", "prev", "curr", "note", "checked_at"],
      "properties": {
        "published": {"type": "boolean"},
        "prev": {"type": ["number", "null"], "minimum": 0},
        "curr": {"type": ["number", "null"], "minimum": 0},
        "note": {"type": "string", "minLength": 1},
        "checked_at": {"type": ["string", "null"], "format": "date"}
      }
    }
  }
}

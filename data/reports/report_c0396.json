  "notice_info": {
    "period": {
      "start": "2026.09.15",
      "end": "2026.09.29"
    },
    "rules": [
      {
        "topic": "병역",
        "text": "단, ‘26.12.27까지 전역예정자로서 전형절차에 응시 가능한 경우에 지원 가능"
      },
      {
        "topic": "병역",
        "text": "병역 미필자도 지원 가능하며, 현재 군 복무중인 자는 ‘26.12.27까지 전역예정자로서 전형절차에 응시 가능한 경우에 지원 가능"
      },
      {
        "topic": "학력",
        "text": "ㅇ (학력) 고교졸업예정자 및 최종학력이 고졸인 자(고교 검정고시 합격자 및 대학 중퇴자, 대학 재학·휴학자 포함)"
      },
      {
        "topic": "기타",
        "text": "합격자 발표일로부터 2개월(‘27.2.17(수) 16시)까지 결원이 발생한 경우에 한해 예비합격자 순위에 의거 임용함"
      }
    ],
    "submissions": [
      "자기소개서 제출 및 사전 온라인검사(평가점수 미반영, 면접 참고자료 활용)",
      "ㅇ (공통) 필기전형 합격자 대상 면접참고자료를 위해 자기소개서 제출 및 인성검사 시행, 기한내 미응시할 경우 지원의사가 없는 것으로 간주하여 면접전형 응시 불가",
      "ㅇ (대상) 필기전형 합격자 중 자기소개서 제출, 사전 온라인 검사 및 서류제출 완료자"
    ],
